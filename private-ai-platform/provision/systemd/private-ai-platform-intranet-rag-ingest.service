[Unit]
Description=Intranet RAG ingest for private-ai-platform
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/opt/private-ai-platform/scripts/intranet_rag/.env
ExecStart=/usr/bin/flock -n /run/private-ai-platform-intranet-rag-ingest.lock /opt/private-ai-platform/scripts/intranet_rag/venv/bin/python -u /opt/private-ai-platform/scripts/intranet_rag/ingest.py
Nice=10

[Install]
WantedBy=multi-user.target
