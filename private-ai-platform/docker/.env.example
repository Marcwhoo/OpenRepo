# Nach .env kopieren und lokal anpassen. Nicht committen.

COMPOSE_PROJECT_NAME=privateai

# Oeffentlich sichtbarer Hostname der Plattform
PUBLIC_HOSTNAME=ai.example.org

# Zeitzone innerhalb der Container
TZ=Europe/Berlin

# Ollama im Docker-Netz
OLLAMA_BASE_URL=http://ollama:11434

# CPU-sichere Standardwerte fuer kleinere Hosts
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=24h
OLLAMA_MAX_LOADED_MODELS=1

# Open WebUI
# WEBUI_SECRET_KEY=
RAG_SYSTEM_CONTEXT=true
WEB_FETCH_MAX_CONTENT_LENGTH=50000

# Interne SearXNG-URL fuer Open WebUI
SEARXNG_QUERY_URL=http://searxng:8080/search

# Optionaler Signal-Bridge-Betrieb
# SIGNAL_CLI_MODE=native
# SIGNAL_BOT_NUMBER=+491234567890
# SIGNAL_ALLOWLIST=+491111111111,+492222222222
# OPENWEBUI_API_KEY=
# OPENWEBUI_MODEL=ollama/qwen3:4b
# PAIRING_ENABLED=0
# PAIRING_SECRET=
# OPENWEBUI_KNOWLEDGE_ID=
# RATE_LIMIT_SECONDS=3
# OPENWEBUI_MAX_HISTORY_MESSAGES=40
# OPENWEBUI_READ_TIMEOUT_SECONDS=600
# SIGNAL_USE_HTTP_POLL=0
# SIGNAL_RECEIVE_MODE=http
# SIGNAL_HTTP_RECEIVE_TIMEOUT=30
