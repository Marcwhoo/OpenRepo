# Nach .env kopieren, lokal fuellen, Rechte restriktiv setzen und nicht committen.

# Geschuetzte Website, die fuer RAG exportiert werden soll
INTRANET_BASE_URL=https://intranet.example.org

# Beispiel fuer NTLM-Authentifizierung: DOMAIN\user
INTRANET_NTLM_USER=EXAMPLE\svc-rag-crawler
INTRANET_NTLM_PASS=

# Zielordner fuer exportierte Textdateien
INTRANET_OUTPUT_DIR=/opt/private-ai-platform/data/intranet-rag

# Optional: konkrete Sitemap-URL(s), komma-getrennt
# INTRANET_SITEMAP_URL=https://intranet.example.org/sitemap.xml

# Optional: Start-URLs, wenn keine Sitemap verfuegbar ist
# INTRANET_SEED_URLS=https://intranet.example.org/

INTRANET_REQUEST_DELAY=0.5
INTRANET_CONCURRENCY=1
INTRANET_MAX_PAGES=2000
INTRANET_DISCOVER_LINKS=0
INTRANET_INSECURE_TLS=0

# Optional
# INTRANET_STATE_FILE=/opt/private-ai-platform/data/intranet-rag/.ingest-state.sqlite3
# INTRANET_MAX_BYTES=104857600
# INTRANET_SKIP_DONE_WITHOUT_VALIDATOR=0
# INTRANET_OCR_LANG=deu
# INTRANET_OCR_DPI=200
# INTRANET_OCR_MAX_PAGES=0
# INTRANET_BOILERPLATE_LINES=Navigation

# Open WebUI API
# OPENWEBUI_BASE_URL=https://ai.example.org
# OPENWEBUI_API_KEY=
# OPENWEBUI_KNOWLEDGE_ID=
# OPENWEBUI_KNOWLEDGE_ID_DIRECTORY=
# OPENWEBUI_CA_BUNDLE=/opt/private-ai-platform/docker/certs/fullchain.pem
# OPENWEBUI_INSECURE_TLS=0
# OPENWEBUI_SYNC_DIR=/opt/private-ai-platform/data/intranet-rag
# OPENWEBUI_KB_STATE_FILE=/opt/private-ai-platform/data/intranet-rag/.openwebui-state.json
# OPENWEBUI_PROCESS_TIMEOUT=600
# OPENWEBUI_POLL_INTERVAL=2
# OPENWEBUI_API_DELAY=0.2
# OPENWEBUI_API_RETRIES=3
# OPENWEBUI_API_BACKOFF=1
# OPENWEBUI_MAX_FILE_SIZE=2097152

# Optionales Fehlerprotokoll
# INTRANET_DEBUG_LOG=/opt/private-ai-platform/data/intranet-rag/debug.txt

# Directory-RAG
# LDAP_URI=ldaps://ldap.example.org
# LDAP_BIND_DN=
# LDAP_BIND_PW=
# LDAP_BASE_DN=
# LDAP_GROUP_DN=
# LDAP_GROUP_NAME=AI Platform Users
# LDAP_CA_BUNDLE=/opt/private-ai-platform/docker/certs/fullchain.pem
# LDAP_INSECURE_TLS=0
# LDAP_TLS_SECLEVEL=0
# DIRECTORY_OUTPUT_DIR=/opt/private-ai-platform/data/directory-rag
# DIRECTORY_EXPORT_FILENAME=directory-export.txt
